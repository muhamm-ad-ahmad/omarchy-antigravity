#!/usr/bin/env python3
# omarchy:summary=Collect Google Antigravity (agy) usage into Omarchy agents panel JSON
import os
import sys
import glob
import json
import sqlite3
import datetime
import subprocess

def collect_usage():
    home = os.path.expanduser("~")
    history_file = os.path.join(home, ".gemini/antigravity-cli/history.jsonl")
    db_file = os.path.join(home, ".gemini/antigravity-cli/conversation_summaries.db")
    usage_dir = os.path.join(home, ".local/state/omarchy/agents/usage")
    os.makedirs(usage_dir, exist_ok=True)

    now_local = datetime.datetime.now().astimezone()
    today_local = now_local.date()
    today_str = today_local.isoformat()

    date_tokens = {}
    recent_days_keys = []
    for i in range(6, -1, -1):
        d = (today_local - datetime.timedelta(days=i)).isoformat()
        date_tokens[d] = 0
        recent_days_keys.append(d)

    total_prompts = 0
    today_prompts = 0
    active_dates = set()

    # 1. Parse prompt history
    if os.path.exists(history_file):
        try:
            with open(history_file, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        item = json.loads(line)
                        total_prompts += 1
                        ts = item.get("timestamp")
                        if ts:
                            dt = datetime.datetime.fromtimestamp(ts / 1000.0).astimezone()
                            d_str = dt.date().isoformat()
                            active_dates.add(d_str)
                            if d_str == today_str:
                                today_prompts += 1
                    except Exception:
                        continue
        except Exception:
            pass

    # 2. Calculate token usage from conversation transcripts (~4 chars/token)
    total_tokens = 0
    today_tokens = 0
    for f in glob.glob(f"{home}/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"):
        try:
            with open(f, "r", encoding="utf-8", errors="replace") as fp:
                for line in fp:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        step = json.loads(line)
                        dt_str = step.get("created_at")
                        if not dt_str:
                            continue
                        dt = datetime.datetime.fromisoformat(dt_str.replace("Z", "+00:00")).astimezone()
                        date_str = dt.date().isoformat()
                        
                        chars = 0
                        for k in ["content", "thinking"]:
                            val = step.get(k)
                            if val and isinstance(val, str):
                                chars += len(val)
                        if "tool_calls" in step and isinstance(step["tool_calls"], list):
                            for tc in step["tool_calls"]:
                                chars += len(str(tc.get("args", "")))
                                
                        tokens = max(1, chars // 4)
                        total_tokens += tokens
                        if date_str in date_tokens:
                            date_tokens[date_str] += tokens
                        if date_str == today_str:
                            today_tokens += tokens
                    except Exception:
                        continue
        except Exception:
            pass

    total_sessions = 0
    today_sessions = 0

    # 3. Read conversation counts from SQLite summaries
    if os.path.exists(db_file):
        try:
            conn = sqlite3.connect(f"file:{db_file}?mode=ro", uri=True)
            cur = conn.cursor()
            cur.execute("SELECT COUNT(*) FROM conversation_summaries")
            row = cur.fetchone()
            if row:
                total_sessions = row[0]
            cur.execute("SELECT last_modified_time FROM conversation_summaries")
            for (lm_str,) in cur.fetchall():
                if lm_str:
                    try:
                        clean_s = lm_str.split("+")[0]
                        dt = datetime.datetime.fromisoformat(clean_s[:26]).replace(tzinfo=datetime.timezone.utc).astimezone()
                        if dt.date() == today_local:
                            today_sessions += 1
                    except Exception:
                        pass
            conn.close()
        except Exception:
            pass

    # In Omarchy's panel, recentDays.messageCount is actually formatted as tokens
    recent_days_list = [{"date": d, "messageCount": date_tokens[d]} for d in recent_days_keys]

    # Model breakdown
    model_usage = {}
    if total_tokens > 0:
        in_tok = int(total_tokens * 0.4)
        out_tok = int(total_tokens * 0.6)
        model_usage["gemini-3.8-flash"] = {
            "inputTokens": in_tok,
            "outputTokens": out_tok,
            "cacheReadInputTokens": 0,
            "cacheCreationInputTokens": 0
        }

    record = {
        "schemaVersion": 1,
        "id": "gemini",
        "name": "Antigravity",
        "updatedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": True,
        "hasPromptStats": True,
        "todayPrompts": today_prompts,
        "todaySessions": today_sessions,
        "todayTotalTokens": today_tokens,
        "todayTokensByModel": {"gemini-3.8-flash": today_tokens},
        "recentDays": recent_days_list,
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": max(1, len(active_dates)),
        "modelUsage": model_usage,
        "limits": [],
        "tierLabel": "Google Antigravity",
        "usageStatusText": "Active",
        "authHelpText": ""
    }

    target_file = os.path.join(usage_dir, "gemini.json")
    tmp_file = os.path.join(usage_dir, ".gemini.json.tmp")
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(record, f, indent=2)
    os.replace(tmp_file, target_file)

    # Trigger shell panel refresh if omarchy-shell is running
    try:
        subprocess.run(["omarchy-shell", "omarchy.agents", "refresh"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

    return record

if __name__ == "__main__":
    rec = collect_usage()
    if "--print" in sys.argv or "-p" in sys.argv:
        print(json.dumps(rec, indent=2))
